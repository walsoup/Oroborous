{
  "expo": {
    "name": "Oroborous",
    "slug": "oroborous",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itswal.oroborous.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6F0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.itswal.oroborous.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
